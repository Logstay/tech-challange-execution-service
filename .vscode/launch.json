{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/main.go",
      "args": [
        "--file=${workspaceFolder}/cmd/service.yaml"
      ],
      "env": {
        "CGO_ENABLED": "0",
        "TRACE_SERVICE_VERSION": "1.0.0",
        "TRACE_SERVICE_NAME": "tech-service",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
        "OTEL_METRICS_EXPORT": "otlp",
        "JWT_SECRET": "secretteste"
      },
      "showLog": true,
      "trace": "verbose",
      "preLaunchTask": "start-dependencies",
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
    {
      "name": "🧪 Debug Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "0"
      },
      "buildFlags": "-v",
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Debug Current Test File",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "env": {
        "CGO_ENABLED": "0"
      },
      "buildFlags": "-v",
      "console": "integratedTerminal"
    },
    {
      "name": "🏃 Run API (No Debug)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/cmd/main.go",
      "args": [
        "--file=${workspaceFolder}/cmd/service.yaml"
      ],
      "env": {
        "CGO_ENABLED": "0",
        "TRACE_SERVICE_VERSION": "1.0.0",
        "TRACE_SERVICE_NAME": "tech-service",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
        "OTEL_METRICS_EXPORT": "otlp",
        "JWT_SECRET": "secretteste"
      },
      "preLaunchTask": "build-api",
      "console": "integratedTerminal"
    }
  ]
}