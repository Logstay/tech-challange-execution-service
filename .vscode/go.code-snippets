    "Tech Challenge Repository": {
        "prefix": "tc-repo",
        "body": [
            "type ${1:Entity}Repository interface {",
            "\tCreate(ctx context.Context, entity *model.${1:Entity}) (*model.${1:Entity}, error)",
            "\tFindByID(ctx context.Context, id string) (*model.${1:Entity}, error)",
            "\tFindAll(ctx context.Context, params ports.FindAllParams) ([]*model.${1:Entity}, error)",
            "\tUpdate(ctx context.Context, entity *model.${1:Entity}) (*model.${1:Entity}, error)",
            "\tDelete(ctx context.Context, id string) error",
            "}"
        ],
        "description": "Template para Repository interface"
    },
    "Tech Challenge Service": {
        "prefix": "tc-service",
        "body": [
            "type ${1:Entity}Service interface {",
            "\tCreate(ctx context.Context, cmd commands.Create${1:Entity}) (*model.${1:Entity}, error)",
            "\tFindByID(ctx context.Context, query queries.FindBy${1:Entity}ID) (*model.${1:Entity}, error)",
            "\tFindAll(ctx context.Context, query queries.FindAll${1:Entity}) ([]*model.${1:Entity}, error)",
            "\tUpdate(ctx context.Context, cmd commands.Update${1:Entity}) (*model.${1:Entity}, error)",
