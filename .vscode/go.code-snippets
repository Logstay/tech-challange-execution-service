    "Tech Challenge Handler": {
        "prefix": "tc-handler",
        "body": [
            "func (h *${1:Entity}Handler) Create${1:Entity}(c *gin.Context) {",
            "\tctx, span := h.tracer.Start(c.Request.Context(), \"handler.Create${1:Entity}\")",
            "\tdefer span.End()",
            "",
            "\tvar req Create${1:Entity}Request",
            "\tif err := c.ShouldBindJSON(&req); err != nil {",
            "\t\tspan.RecordError(err)",
            "\t\tc.JSON(http.StatusBadRequest, gin.H{\"error\": err.Error()})",
            "\t\treturn",
            "\t}",
            "",
            "\tcmd := commands.Create${1:Entity}{",
            "\t\t// Map request to command",
            "\t}",
            "",
            "\tentity, err := h.service.Create(ctx, cmd)",
            "\tif err != nil {",
            "\t\tspan.RecordError(err)",
            "\t\tc.JSON(http.StatusInternalServerError, gin.H{\"error\": err.Error()})",
            "\t\treturn",
            "\t}",
            "",
            "\tresponse := ${1:Entity}Response{",
            "\t\t// Map entity to response",
            "\t}",
            "",
            "\tc.JSON(http.StatusCreated, response)",
            "}"
        ],
        "description": "Template para Handler de criação"
    },
    "Tech Challenge Test": {
        "prefix": "tc-test",
        "body": [
            "func Test${1:FunctionName}(t *testing.T) {",
            "\t// Given",
            "\t${2:// arrange}",
            "",
            "\t// When",
            "\t${3:// act}",
            "",
            "\t// Then",
            "\t${4:// assert}",
            "\trequire.NoError(t, err)",
            "\tassert.NotNil(t, result)",
            "}"
        ],
        "description": "Template para testes unitários"
    },
