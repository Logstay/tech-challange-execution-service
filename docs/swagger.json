    "definitions": {
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 400
                },
                "error": {
                    "type": "string",
                    "example": "invalid request"
                }
            }
        },
        "http.GetConsumableResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "KIT-001"
                },
                "created_at": {
                    "type": "string",
                    "example": "2024-01-01T12:00:00Z"
                },
                "description": {
                    "type": "string",
                    "example": "kit de embreagem completo para carros de passeio"
                },
                "name": {
                    "type": "string",
                    "example": "Kit Embreagem"
                },
                "price": {
                    "type": "number",
                    "example": 100
                },
                "quantity": {
                    "type": "integer",
                    "example": 100
                },
                "uid": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2024-01-01T12:00:00Z"
                }
            }
        },
        "http.GetServiceDefinitionResponse": {
            "type": "object",
            "properties": {
