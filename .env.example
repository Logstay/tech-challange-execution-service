# Server Configuration
REST_SERVER_HOST=0.0.0.0
REST_SERVER_PORT=8080

# Mercado Pago Configuration
MERCADO_PAGO_ACCESS_TOKEN=your_mercadopago_access_token_here

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=billing

# Kafka Configuration
KAFKA_PRODUCER_HOSTS=localhost:9092
KAFKA_CONSUMER_HOSTS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Optional: JWT Configuration (se necessário para autenticação)
JWT_SECRET=your_jwt_secret_here

# Optional: New Relic (se configurado)
NEW_RELIC_APP_NAME=tech-challenge-billing-service
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key

# Optional: Email Configuration (se necessário)
EMAIL_SENDER_NAME=
EMAIL_SENDER_EMAIL=

# Optional: Auth Lambda
AUTH_LAMBDA_HOST=

# Optional: Tracing
TRACING_SERVICE_NAME=tech-challange-execution-service
TRACING_SERVICE_VERSION=1.0.0
